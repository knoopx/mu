{
  "name": "mu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GPUix desktop app: agentic chat, rendered by @gpuix/react with adwaita-gpuix",
  "scripts": {
    "dev": "bun --hot app.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@gpuix/native": "0.10.0",
    "@gpuix/react": "0.10.0",
    "@oh-my-pi/snapcompact": "18.18.1",
    "@openuidev/lang-core": "^1.0.2",
    "@openuidev/react-lang": "^1.0.2",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "@wterm/core": "0.5.9",
    "adwaita-gpuix": "workspace:*",
    "pele": "1.6.0",
    "react": "^19.2.4",
    "typebox": "1.3.27",
    "web-tree-sitter": "0.27.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "prettier": "3.5.1",
    "typescript": "^5.3.0"
  }
}
